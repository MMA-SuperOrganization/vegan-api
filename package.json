{
  "name": "vegan-api-mma302",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Vegan Support Mobile Application (MMA302)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:database": "vitest run tests/database",
    "test:playwright": "playwright test",
    "test:playwright:list": "playwright test --list",
    "test:playwright:coverage": "node scripts/check-playwright-coverage.js",
    "test:playwright:report": "playwright show-report",
    "test:playwright:memory": "node --expose-gc node_modules/@playwright/test/cli.js test --grep NFR-0012",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:check": "node scripts/generate-docs.js --check",
    "smoke": "node scripts/smoke.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node --env-file=.env scripts/seed.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "media:cleanup": "node --env-file=.env scripts/cleanup-media.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "db:indexes": "node --env-file=.env scripts/provision-indexes.js",
    "preflight": "node --env-file=.env scripts/preflight.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "mongoose": "9.10.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "slugify": "1.6.9",
    "swagger-ui-express": "5.0.1",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  }
}
