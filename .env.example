NODE_ENV=development
PORT=3000
MONGODB_URI=
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=debug

# Optional: số proxy phía trước app (Render/Nginx...). 0 = không tin X-Forwarded-For
TRUST_PROXY=0
# Optional: bật/tắt Swagger UI tại /api-docs (mặc định: bật, trừ production)
SWAGGER_ENABLED=true

# Firebase Admin: điền đủ 3 biến (service account) HOẶC chỉ FIREBASE_PROJECT_ID
# và dùng Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
# FIREBASE_PRIVATE_KEY giữ nguyên "\n" trong một dòng, đặt trong dấu ngoặc kép.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2: bắt buộc trong production; ở development bỏ trống để tắt media upload
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_PRESIGNED_URL_EXPIRES_IN=300
